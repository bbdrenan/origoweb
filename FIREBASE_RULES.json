{
  "rules": {
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        "sales": {
          ".indexOn": ["date", "status", "total"]
        },
        "products": {
          ".indexOn": ["name", "sku", "quantity"]
        },
        "expenses": {
          ".indexOn": ["date", "category", "amount"]
        },
        "costs": {
          ".indexOn": ["date", "category"]
        },
        "profile": {
          ".read": "$uid === auth.uid",
          ".write": "$uid === auth.uid",
          ".validate": "newData.hasChildren(['name', 'email', 'businessName'])"
        },
        "settings": {
          ".read": "$uid === auth.uid",
          ".write": "$uid === auth.uid"
        },
        "backups": {
          ".read": "$uid === auth.uid",
          ".write": "$uid === auth.uid",
          ".indexOn": ["date"]
        }
      }
    },
    "analytics": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        ".indexOn": ["date", "event"]
      }
    },
    ".read": false,
    ".write": false
  }
}
